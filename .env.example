# ---------------------------------------------------------------------------
# BreastScan API — copy to .env and fill in.
# Never commit the real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Origins allowed by CORS — the website that calls this API.
# Comma-separate for several hosts, e.g.
#   CLIENT_URL=https://breastscan.health,https://www.breastscan.health
CLIENT_URL=http://localhost:3000

# --------------------------------- MySQL ----------------------------------
# Create the database first (utf8mb4, for the Nepali names):
#   CREATE DATABASE breastscan CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# On cPanel these come from "MySQL® Databases" and are prefixed with your
# account name, e.g. breastscan_db / breastscan_user. The host stays localhost.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=breastscan
DB_USER=breastscan_user
# Quote the password if it contains # (dotenv cuts unquoted values at #).
DB_PWD="change-me"

# Shared hosting caps concurrent connections — leave this small.
DB_POOL_MAX=5
# Set true to echo every SQL statement while debugging.
DB_LOGGING=false
# Leave off. New tables and columns are added on boot without it.
# true runs sequelize.sync({ alter: true }) on boot — only for a one-off column
# type change, since on MySQL each run adds another copy of every unique index.
DB_SYNC_ALTER=false

# ---------------------------------- Auth -----------------------------------
# CHANGE THIS before deploying. Anyone with this string can mint valid sessions.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# The admin account, created automatically on boot if it does not exist.
# It is never overwritten, so changing the password in the admin survives restarts.
SEED_ADMIN_NAME=BreastScan Admin
SEED_ADMIN_EMAIL=cms@breastscan.health
SEED_ADMIN_PASSWORD="change-me"
